<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Jiaowu import (WebView) and WebDAV sync accept arbitrary user-supplied hosts,
      many of which are campus intranets or self-hosted servers without TLS. A static
      per-domain allowlist can't cover those, so cleartext stays permitted by default;
      the app-side URL normalizers default new input to https:// and only fall back to
      http:// when the user explicitly types it.
    -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
